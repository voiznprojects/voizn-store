generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AccessStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum LoginMethod {
  EMAIL
  GOOGLE
  APPLE
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
  ACCESS_APPROVED
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                String             @id @default(uuid())
  name              String?
  email             String             @unique
  passwordHash      String?
  country           String?
  accessStatus      AccessStatus       @default(PENDING_VERIFICATION)
  role              UserRole           @default(CUSTOMER)
  loginMethod       LoginMethod        @default(EMAIL)
  isEmailVerified   Boolean            @default(false)
  approvedAt        DateTime?
  approvedById      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  favorites         Favorite[]
  orders            Order[]
  verificationCodes VerificationCode[]
  identities        AuthIdentity[]
  approvedBy        User?              @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers     User[]             @relation("UserApprovals")
}

model VerificationCode {
  id         String              @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  purpose    VerificationPurpose @default(SIGNUP)
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AuthIdentity {
  id                String      @id @default(uuid())
  userId            String
  provider          LoginMethod
  providerAccountId String
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  name        String
  tag         String?
  description String?
  price       String?
  artClass    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  orderNumber  Int         @unique
  status       OrderStatus @default(PROCESSING)
  discountCode String?
  purchaseDate DateTime    @default(now())
  deliveryDate DateTime?
  totalAmount  Decimal     @db.Decimal(10, 2)
  currency     String      @default("GBP")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([userId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  variant     String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}